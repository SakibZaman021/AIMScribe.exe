# CMED Web - copy to .env.local (local) or set in the Vercel dashboard.
#
# Never commit real values. .env.local is gitignored.

# ============================================================
# Recording grants  (the agent will not record without these)
# ============================================================
# Ed25519 private key, PKCS#8 PEM. The public half goes on every doctor PC at
#   C:\ProgramData\AIMScribe\keys\cmed_grant_pub.pem
#
# Generate both halves:
#   node -e "const{generateKeyPairSync}=require('crypto');const{privateKey,publicKey}=generateKeyPairSync('ed25519');console.log(privateKey.export({type:'pkcs8',format:'pem'}));console.log(publicKey.export({type:'spki',format:'pem'}))"
#
# In Vercel, paste the PEM with real newlines. In a .env file, use \n escapes.
AIMS_GRANT_PRIVATE_KEY=

# Must match AIMS_GRANT_ISSUER / AIMS_GRANT_AUDIENCE in each agent's .env
AIMS_GRANT_ISSUER=cmed
AIMS_GRANT_AUDIENCE=aimscribe-recorder

# ============================================================
# Doctor sessions
# ============================================================
# At least 32 characters. Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AIMS_SESSION_SECRET=

# Doctor directory. Replace with your hospital's identity provider when available
# by swapping authenticateDoctor() in src/lib/session.ts.
# Generate a password hash:  node scripts/hash-password.mjs "the password"
AIMS_DOCTORS=[{"doctor_id":"DR001","name":"Dr Example","hospital_ids":["HOSP001"],"password":"SALTHEX:HASHHEX"}]

# ============================================================
# Backend
# ============================================================
NEXT_PUBLIC_BACKEND_URL=https://aimscribe-backend-render.onrender.com

# Must match WEBHOOK_SECRET in the backend's environment. Unsigned NER webhooks
# are now rejected, so this is required for prescription fields to populate.
AIMSCRIBE_WEBHOOK_SECRET=

# ============================================================
# Local agent
# ============================================================
# Only change if an agent is configured on a non-default port.
NEXT_PUBLIC_RECORDER_WS=ws://localhost:5050/ws
